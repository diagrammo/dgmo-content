class Ship Class Hierarchy

Vessel [abstract] blue
  # name: string
  + sail(): void

Ship extends Vessel
  # crew: number
  + anchor(): void

Warship extends Ship red
  - cannons: number
  + fire(): void

Galleon extends Warship red
  - treasureHold: number
  + plunder(): void

ManOWar extends Galleon red
  - gunDecks: number
  + broadside(): void

Frigate extends Warship red
  - speed: number
  + chase(): void

Sloop extends Ship green
  - speed: number
  + flee(): void

ShipType [enum]
  Sloop
  Galleon
  ManOWar

Ship
  -> ShipType : has type
